# One image for the payroll pipeline (src/pipeline) and its Streamlit review app (src/feature_extraction/review).
# Code only: data arrives at run time as volumes (see docker-compose.yml), never through the build context.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIPELINE_RUNS_DIR=/runs

COPY --from=ghcr.io/astral-sh/uv:0.12.11 /uv /usr/local/bin/uv

WORKDIR /app

# Dependencies first, so editing code does not reinstall them.
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --no-dev --no-emit-project --no-hashes --group review-app -o requirements.txt \
    && uv pip install --system --no-cache -r requirements.txt \
    && rm requirements.txt

COPY src/ /app/src/
# COPY keeps the host's file modes. A file that is 0600 on the host (it happened to workbook.py) is unreadable to the
# non-root user below, and the import fails in the middle of export. Make the code world-readable whatever the umask was.
RUN chmod -R a+rX /app/src

# Non-root user. /runs is the bind-mounted run folder (./runs on the host), so the user must be able to write to it;
# on Linux that means the host folder is owned by uid 1000 (see src/pipeline/README.md).
RUN useradd --create-home app \
    && mkdir -p /runs \
    && chown app /runs
USER app

EXPOSE 8501

# Streamlit's own flags go before `--`; everything after it reaches src/feature_extraction/review/app.py.
ENTRYPOINT ["streamlit", "run", "/app/src/feature_extraction/review/app.py", \
            "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true", "--"]
CMD ["--source", "run", "--runs-dir", "/runs"]
