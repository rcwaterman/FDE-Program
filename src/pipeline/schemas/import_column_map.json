      "legend_keyword_map": {
        "description": "Legend descriptions are matched by description_patterns (word-boundary regex), not by substring. Client codes are never mapped by a fixed table unless listed in default_code_map."
      },
      "tips_pattern": "\\bTIPS?\\b",
      "cash_pattern": "\\bCASH\\b",
      "credit_pattern": "\\b(CREDIT|CARD|CC)\\b",
      "hours_multipliers": {
        "Reg Hours": 1.0,
        "OT Hours": 1.5,
        "Vacation Hours": 1.0,
        "Sick Hours": 1.0,
        "Holiday Hours": 1.0,
        "PTO Hours": 1.0,
        "Other Hours": null
      },
      "employee_action": {
        "remove_requested": "REMOVE",
        "payee_only": "PAYEE ONLY",
        "new_hire": "NEW HIRE",
        "terminated": "TERMINATED"
      },
      "unmapped_policy": "flag_for_review",
      "summary_label_pattern": "\\b(TOTAL|TOTALS|SUBTOTAL|SUB ?TOTAL)\\b",
      "description_patterns": [
        [
          "\\b(REG|REGULAR)\\b",
          "Reg Hours"
        ],
        [
          "\\b(OT|OVER ?TIME)\\b",
          "OT Hours"
        ],
        [
          "\\bVAC(ATION)?\\b(?!\\s+UNION)",
          "Vacation Hours"
        ],
        [
          "\\bSICK\\b",
          "Sick Hours"
        ],
        [
          "\\bHOL(IDAY)?\\b",
          "Holiday Hours"
        ],
        [
          "\\b(PTO|PERSONAL)\\b",
          "PTO Hours"
        ],
        [
          "\\bBONUS\\b",
          "Bonus Amount"
        ],
        [
          "\\bCOMMISSION\\b",
          "Commission Amount"
        ],
        [
          "\\bDOUBLE\\b",
          "Other Hours"
        ],
        [
          "\\bOTHER\\b",
          "OTHER_BY_MEASURE"
        ]
      ],
      "kind_columns": {
        "tips_cash": "Cash Tips Amount",
        "tips_credit": "Credit Tips Amount",
        "tips_unspecified": "Cash Tips Amount",
        "bonus": "Bonus Amount",
        "commission": "Commission Amount",
